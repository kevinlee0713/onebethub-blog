# ── AI API 키 ──────────────────────────────────────────────────
# Claude (Stage 2/3 생성, 휴머나이징, 번역, Stage 5 검증 중 하나)
ANTHROPIC_API_KEY=sk-ant-...
# GPT-4o-mini (Stage 5 검증) — 없으면 이 검증만 건너뜀(PASS 처리, skipped 표시)
OPENAI_API_KEY=sk-...
# Gemini (Stage 5 검증 + AI 이미지 생성 1순위) — 없으면 검증 건너뜀 + 이미지 Pexels/브랜드로 폴백
GEMINI_API_KEY=...

# ── DRY_RUN (WordPress/SSH 준비 전 로컬 콘텐츠 검증용) ───────────
# true로 설정하면 SSH/WORDPRESS_URL 등 필수 env 체크를 건너뛰고, WordPress 발행 단계 전체를
# "콘솔 출력 + data/dry-run-output/ 파일 저장"으로 대체한다. Stage 1~5 + 이미지 생성은 그대로 실행된다.
DRY_RUN=false

# ── WordPress / SSH (담당자에게 요청 예정 — 준비 전까지는 DRY_RUN=true로만 사용) ──
WORDPRESS_URL=https://onebethub.com
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=
SSH_WP_PATH=/home2/onebethub/public_html
SSH_PORT=22

# 저자 페르소나 — 아직 미정. 단일 WordPress username. 미설정 시 첫 번째 admin으로 자동 폴백.
AUTHOR_ONEBETHUB=

# ── 선택 API (없어도 파이프라인은 동작, 해당 기능만 생략/폴백) ───
SERPER_API_KEY=
PEXELS_API_KEY=

# ── ClickUp (검수 태스크 자동 생성) — VOBET과 별개 워크스페이스/리스트 사용 ──
CLICKUP_API_KEY=
CLICKUP_LIST_ID=

# ── 텔레그램 알림 ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
